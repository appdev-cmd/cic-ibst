# Supabase — copy thành .env và điền giá trị thật
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# CHỈ dùng server-side (script/migration) — KHÔNG đưa vào code frontend
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_DB_PASSWORD=<database-password>

# Tùy chọn: tự đăng nhập khi chạy local để tiện test (chỉ tác dụng với npm run dev)
VITE_AUTO_LOGIN=false
VITE_AUTO_LOGIN_EMAIL=
VITE_AUTO_LOGIN_PASSWORD=

# Tùy chọn: bỏ qua màn hình đăng nhập khi chạy local (chỉ tác dụng với npm run dev) —
# lưu ý: các truy vấn Supabase vẫn bị RLS chặn nếu không có session hợp lệ
VITE_SKIP_AUTH=false

# Cấu hình Trợ lý AI (Google Gemini / Vertex AI)
# LƯU Ý BẢO MẬT: GEMINI_API_KEY KHÔNG lưu ở file .env này và KHÔNG gửi xuống client!
# Key được lưu an toàn trong Supabase Edge Function Secrets:
#   supabase secrets set GEMINI_API_KEY="AIzaSy..." --project-ref <project-id>
# Client gọi AI thông qua Supabase Edge Function `gemini-proxy`.

